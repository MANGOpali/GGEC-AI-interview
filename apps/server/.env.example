# Defaults: local-only demo, durable JSON storage, no AI scoring.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
APP_MODE=demo
WEB_ORIGIN=http://localhost:5173
# For deployed environments set APP_MODE=supabase and NODE_ENV=production.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in Supabase mode. Keep stable and backed up securely; loss prevents decryption.
DATA_ENCRYPTION_KEY=
LLM_PROVIDER=disabled
# For free-tier testing set LLM_PROVIDER=groq and supply a server-only key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# For OpenAI (or any OpenAI-compatible endpoint) set LLM_PROVIDER=openai and supply a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Optional. Defaults to https://api.openai.com/v1. Set only for a compatible gateway.
OPENAI_BASE_URL=
# Optional. Request timeout in ms. Defaults to 180000; slow gateways/reasoning models need longer than Groq.
OPENAI_TIMEOUT_MS=
# Avoid spending free quota backfilling old demo attempts at startup.
AUTO_EVALUATE_EXISTING=false
GEMINI_API_KEY=
# Required when LLM_PROVIDER=gemini: choose an available model in your account.
GEMINI_MODEL=
# Optional. Defaults to gemini-embedding-001. Feeds a supplementary semantic-consistency
# signal into each evaluation prompt (consistency_with_profile). Never decides scores.
GEMINI_EMBEDDING_MODEL=
RETENTION_DAYS=90
# Set only for a known reverse proxy; 0 disables proxy trust.
TRUST_PROXY_HOPS=0

# Speech transcription is independent of the scoring provider.
STT_PROVIDER=browser
GROQ_STT_MODEL=whisper-large-v3
